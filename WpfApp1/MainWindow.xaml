<Window x:Class="WpfApp1.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WpfApp1.ViewModels"
        xmlns:conv="clr-namespace:WpfApp1.Converters"
        xmlns:views="clr-namespace:WpfApp1.Views"
        Title="QuickDock"
        Width="360" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border x:Name="RootBorder"
            Background="{StaticResource BgPrimaryBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True"
            PreviewMouseLeftButtonDown="RootBorder_PreviewMouseLeftButtonDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSecondaryBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="TitleBarIcon" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="QuickDock" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" ToolTip="添加文件或文件夹"
                                Command="{Binding AddItemsCommand}" Padding="6">
                            <TextBlock Text="＋" FontSize="14" FontWeight="Bold"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="设置"
                                Command="{Binding OpenSettingsCommand}" Padding="6" Margin="2,0,0,0">
                            <TextBlock Text="🔧" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="隐藏到任务栏"
                                Command="{Binding HideToTrayCommand}" Padding="6" Margin="2,0,0,0">
                            <TextBlock Text="−" FontSize="14" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Border Grid.Row="1"
                    CornerRadius="0,0,12,12"
                    ClipToBounds="True">
                <Grid>
                    <Grid Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Categories -->
                        <Border Background="{StaticResource BgSecondaryBrush}"
                                Margin="0,0,1,0"
                                CornerRadius="0,0,0,12"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ListBox x:Name="CategoryListBox"
                                         ItemsSource="{Binding Categories}"
                                         SelectedItem="{Binding SelectedCategory}"
                                         PreviewMouseRightButtonDown="CategoryListBox_PreviewMouseRightButtonDown"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Margin="4,8">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource CategoryItem}"/>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ContextMenu>
                                        <ContextMenu Opened="ContextMenu_Opened">
                                            <MenuItem Header="重命名" Click="RenameCategoryMenuItem_Click"/>
                                            <MenuItem Header="删除" Click="DeleteCategoryMenuItem_Click"/>
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                </ListBox>

                                <Button Grid.Row="1" Content="+ 分类" Style="{StaticResource ModernButton}"
                                        Margin="8" FontSize="12"
                                        Command="{Binding AddCategoryCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Category Content -->
                        <Grid Grid.Column="1">
                            <views:ShortcutCategoryView
                                Visibility="{Binding IsShortcutCategory, Converter={StaticResource BoolVis}}"/>
                            <views:NoteCategoryView
                                Visibility="{Binding IsNoteCategory, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                    </Grid>

                    <!-- 边缘吸附收起时的细条指示（自由模式收起不显示） -->
                    <Border x:Name="CollapsedStripBorder"
                            Visibility="{Binding ShowEdgeCollapsedIndicator, Converter={StaticResource BoolVis}}"
                            Background="{StaticResource BgSecondaryBrush}"
                            CornerRadius="0,0,12,12"
                            ClipToBounds="True"
                            AllowDrop="True"
                            DragEnter="CollapsedStrip_DragEnter"
                            DragOver="CollapsedStrip_DragOver"
                            Drop="CollapsedStrip_Drop">
                        <Border Width="3"
                                Background="{StaticResource AccentBrush}"
                                HorizontalAlignment="{Binding CollapsedStripAlignment}"
                                Opacity="0.8"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
