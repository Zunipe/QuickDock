<views:CategoryContentViewBase x:Class="WpfApp1.Views.ShortcutCategoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:WpfApp1.Converters"
        xmlns:views="clr-namespace:WpfApp1.Views"
        AllowDrop="True"
        DragOver="ItemsArea_DragOver"
        Drop="ItemsArea_Drop">
    <views:CategoryContentViewBase.Resources>
        <conv:EmptyCollectionVisibilityConverter x:Key="EmptyVis"/>
    </views:CategoryContentViewBase.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="4">
            <ItemsControl x:Name="LaunchItemsControl"
                          ItemsSource="{Binding FilteredItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource LaunchItemCard}"
                                AllowDrop="True"
                                DragOver="ItemCard_DragOver"
                                Drop="ItemCard_Drop"
                                MouseLeftButtonDown="ItemCard_MouseLeftButtonDown"
                                MouseMove="ItemCard_MouseMove"
                                MouseLeftButtonUp="ItemCard_MouseLeftButtonUp"
                                Tag="{Binding}">
                            <Border.ContextMenu>
                                <ContextMenu Opened="ContextMenu_Opened">
                                    <MenuItem Header="修改名称和图标" Click="EditItemMenuItem_Click"/>
                                    <Separator/>
                                    <MenuItem Header="删除" Click="DeleteItemMenuItem_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Source="{Binding Icon}" Width="40" Height="40"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Text="{Binding Name}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="80"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="4,4,4,6"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="拖拽文件/文件夹到此处&#x0a;或点击 ＋ 添加"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   IsHitTestVisible="False"
                   Visibility="{Binding FilteredItems, Converter={StaticResource EmptyVis}}"/>
    </Grid>
</views:CategoryContentViewBase>
