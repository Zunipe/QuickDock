<Window x:Class="WpfApp1.Views.AddCategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource ModernWindow}"
        Title="新建分类" Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource BgSecondaryBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="新建分类" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <TextBlock Grid.Row="1" Text="分类名称:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            <TextBox x:Name="NameBox" Grid.Row="2" Text="新分类" KeyDown="NameBox_KeyDown"/>

            <TextBlock Grid.Row="3" Text="分类功能:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,8"/>
            <ComboBox x:Name="TypeBox" Grid.Row="4" SelectedIndex="0">
                <ComboBoxItem Content="快捷方式" Tag="Shortcut"/>
                <ComboBoxItem Content="便签" Tag="Note"/>
            </ComboBox>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Style="{StaticResource ModernButton}" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="确定" Style="{StaticResource AccentButton}" Width="80" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
