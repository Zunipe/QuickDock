<views:CategoryContentViewBase x:Class="WpfApp1.Views.NoteCategoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WpfApp1.Views">
    <Border Margin="12"
            Background="{StaticResource BgTertiaryBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <TextBox Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="8"
                 MinHeight="0"
                 SpellCheck.IsEnabled="False"/>
    </Border>
</views:CategoryContentViewBase>
